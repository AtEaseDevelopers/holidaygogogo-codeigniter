DB_HOST=localhost
DB_DATABASE=database
DB_USERNAME=root
DB_PASSWORD=password
BASE_URL=http://holidaygogogo.test

# Customer Portal HMAC Secret (64 character hex string)
CUSTOMER_PORTAL_HMAC_SECRET=

APP_ENV=local
# APP_ENV=prod

# GoHighLevel
GHL_API_TOKEN=
GHL_API_VERSION=2021-07-28
GHL_LOCATION_ID=
GHL_PAGE_SIZE=100
GHL_CONTACTS_SYNC_DAYS=3
GHL_CONVERSATIONS_SYNC_DAYS=3
GHL_MAX_PAGES_PER_RUN=50

# Competitor Analysis (Owner-only tab). A pasted URL runs a background crawl job
# (discover every product via sitemap / HTML crawl / headless, read each to text),
# then you Review & Select which products to analyse with OpenAI vs our packages.
# AI is on only when OPENAI_API_KEY is set — blank = crawl & review without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional token-price overrides (USD per 1M) for the AI cost estimate.
# OPENAI_PRICE_INPUT=0.15
# OPENAI_PRICE_OUTPUT=0.60
# FAQ suggestion semantic-dedupe cosine cut-off (default 0.86; lower = catches
# more reworded duplicates). Set 0 or >= 1 to disable the embedding dedupe pass.
# FAQ_SUGGESTION_SEMANTIC_THRESHOLD=0.80
# Max FAQ suggestions kept from one AI reply (safety backstop; default 200).
# Set 0 to keep every suggestion uncapped — the prompt already asks the model
# to be exhaustive, so raise/disable this if long-tail suggestions get dropped.
# FAQ_SUGGESTION_MAX_SUGGESTIONS=200
# Linked brochure/itinerary files are read into the source text: PDFs via
# pdftotext (poppler), images via tesseract OCR. Set binary paths if not on PATH;
# TESSERACT_LANG sets OCR language(s), e.g. eng+chi_sim.
# PDFTOTEXT_BIN=/usr/bin/pdftotext
# TESSERACT_BIN=/usr/bin/tesseract
# TESSERACT_LANG=eng
# --- Competitor crawler ---
# It AUTO-TUNES for maximum coverage — you normally set NOTHING here. Each crawl
# discovers every product (sitemap + link-crawl + headless render, unioned), reads
# them in resumable 500-chunks that survive blocks/kills, and runs one at a time.
#
# The ONLY setting you're likely to touch: a proxy, to get past a site that IP-blocks
# you. Routes ALL traffic (curl + headless) through it. Off unless set.
# COMPETITOR_PROXY=http://proxy-host:8080          # scheme://host:port (http/https/socks5)
# COMPETITOR_PROXY_AUTH=username:password          # if the proxy needs a login
#
# Under php-fpm only, if the background worker can't spawn, set the CLI php path:
# PHP_CLI_BIN=/usr/bin/php
#
# Advanced knobs — rarely needed; max-coverage defaults shown, leave unset to use them:
#   COMPETITOR_MAX_DISCOVER_URLS=20000  COMPETITOR_MAX_READ=0(no cap)  COMPETITOR_READ_CHUNK=500
#   COMPETITOR_MAX_HEADLESS=500  COMPETITOR_DRILL_MAX=800  COMPETITOR_FETCH_TIMEOUT=15
#   COMPETITOR_HTTP_CACHE_TTL=-1(off)  RENDER_BLOCK_ASSETS=1  HEADLESS_BROWSER_BIN/NODE_BIN=auto

# Power BI embed (Azure app + workspace)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
# Optional: default report for direct embed
POWERBI_REPORT_ID=
POWERBI_EMBED_URL=

# Admin two-factor (TOTP / Google Authenticator) — encrypts the shared secret
# at rest (AES-256-GCM). REQUIRED for 2FA. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
TOTP_ENCRYPTION_KEY=

# Admin 2FA master switch. false = skip the Google Authenticator step entirely
# (e.g. local dev). Any other value or unset keeps 2FA enforced.
TWOFA_ENABLED=true
