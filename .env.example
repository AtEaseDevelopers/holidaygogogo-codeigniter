DB_HOST=localhost
DB_DATABASE=database
DB_USERNAME=root
DB_PASSWORD=password
BASE_URL=http://holidaygogogo.test

# Customer Portal HMAC Secret (64 character hex string)
CUSTOMER_PORTAL_HMAC_SECRET=

APP_ENV=local
# APP_ENV=prod

# GoHighLevel
GHL_API_TOKEN=
GHL_API_VERSION=2021-07-28
GHL_LOCATION_ID=
GHL_PAGE_SIZE=100
GHL_CONTACTS_SYNC_DAYS=3
GHL_CONVERSATIONS_SYNC_DAYS=3
GHL_MAX_PAGES_PER_RUN=50

# Competitor Analysis (Owner-only tab). A pasted URL runs a background crawl job
# (discover every product via sitemap / HTML crawl / headless, read each to text),
# then you Review & Select which products to analyse with OpenAI vs our packages.
# AI is on only when OPENAI_API_KEY is set — blank = crawl & review without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional token-price overrides (USD per 1M) for the AI cost estimate.
# OPENAI_PRICE_INPUT=0.15
# OPENAI_PRICE_OUTPUT=0.60
# FAQ suggestion semantic-dedupe cosine cut-off (default 0.86; lower = catches
# more reworded duplicates). Set 0 or >= 1 to disable the embedding dedupe pass.
# FAQ_SUGGESTION_SEMANTIC_THRESHOLD=0.80
# Max FAQ suggestions kept from one AI reply (safety backstop; default 200).
# Set 0 to keep every suggestion uncapped — the prompt already asks the model
# to be exhaustive, so raise/disable this if long-tail suggestions get dropped.
# FAQ_SUGGESTION_MAX_SUGGESTIONS=200
# Linked brochure/itinerary files are read into the source text: PDFs via
# pdftotext (poppler), images via tesseract OCR. Set binary paths if not on PATH;
# TESSERACT_LANG sets OCR language(s), e.g. eng+chi_sim.
# PDFTOTEXT_BIN=/usr/bin/pdftotext
# TESSERACT_BIN=/usr/bin/tesseract
# TESSERACT_LANG=eng
# A crawl discovers EVERY product on the site (uncapped). COMPETITOR_FETCH_TIMEOUT
# caps each page fetch in seconds (default 15) so one slow page can't stall it.
# COMPETITOR_FETCH_TIMEOUT=15
# JS listing/product pages our fetch can't read are rendered with headless Chrome
# (discovers tour links + reads full content). Set the browser path if not
# auto-detected; cap renders per crawl (~2-4s each; default 30, 0 = unlimited).
# HEADLESS_BROWSER_BIN=/usr/bin/google-chrome
# COMPETITOR_MAX_HEADLESS=30
# Hard wall-clock timeout (seconds) per headless render — a page with live JS
# timers can otherwise hang Chrome forever and freeze the crawl (default 35).
# COMPETITOR_HEADLESS_TIMEOUT=35
# JS sites with no product sitemap: after rendering the homepage we also render up
# to this many of its category pages to reach JS-injected tours (default 12).
# COMPETITOR_HEADLESS_CATEGORIES=12
# A category/listing page (e.g. "…-tours") is drilled into its individual products;
# cap the extra pages that drill can add per crawl (default 150).
# COMPETITOR_DRILL_MAX=150
# Sites that hide every product behind category pages (listing.php?…) are seeded with
# those category pages so the drill reaches the products; cap the seeds (default 40).
# COMPETITOR_MAX_CATEGORY_SEEDS=40
# Optional Playwright render service (tools/competitor_render) for JS-SPA competitor
# sites: runs a real browser, scrolls for lazy-load, and captures the JSON APIs the
# page fetches (reaches products that plain Chrome --dump-dom can't). Install once:
#   cd tools/competitor_render && npm install && npx playwright install chromium
# Set NODE_BIN if node isn't on the worker's PATH (e.g. nvm installs). Falls back to
# Chrome --dump-dom automatically when not installed.
# NODE_BIN=/usr/local/bin/node
# COMPETITOR_RENDER_CMD=/usr/local/bin/node /full/path/tools/competitor_render/render.js
# RENDER_TIMEOUT_MS=25000
# RENDER_MAX_APIS=40
# Crawls run as a background CLI job; under php-fpm set the CLI php path
# (PHP_BINARY is php-fpm there). Auto-resolved from common paths if unset.
# PHP_CLI_BIN=/usr/bin/php

# Power BI embed (Azure app + workspace)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
# Optional: default report for direct embed
POWERBI_REPORT_ID=
POWERBI_EMBED_URL=
